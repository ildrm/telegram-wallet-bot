MYSQL_ROOT_PASSWORD=
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=array
WALLET_LIVE_ENABLED=false
CUSTODY_DRIVER=fake
CUSTODY_WEBHOOK_SECRET=
FAKE_CUSTODY_MODE=submitted
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# JSON object: numeric Telegram ID => array of least-privilege role names.
TELEGRAM_ADMIN_ROLES={}
OWNER_PAYOUT_ADDRESS=
